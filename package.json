{
  "name": "agentx-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "format": "prettier --write .",
    "config:check": "node packages/config/bin/check.mjs",
    "db:migrate": "pnpm --filter @agentx/db migrate",
    "db:seed": "pnpm --filter @agentx/db seed",
    "dev": "pnpm -r --parallel dev",
    "verify:indexer": "node scripts/verify-indexer.mjs",
    "verify:keystore": "node scripts/verify-keystore.mjs",
    "e2e": "node scripts/e2e.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "postgres": "^3.4.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "viem": "^2.21.0",
    "vitest": "^2.1.9",
    "@agentx/config": "workspace:*",
    "@agentx/db": "workspace:*",
    "@agentx/shared": "workspace:*",
    "@agentx/sdk": "workspace:*",
    "@agentx/agent-core": "workspace:*",
    "zod": "^3.23.8"
  }
}
