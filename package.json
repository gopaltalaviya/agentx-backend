{
  "name": "agentx-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "config:check": "node packages/config/bin/check.mjs",
    "db:migrate": "pnpm --filter @agentx/db migrate",
    "dev": "pnpm -r --parallel dev",
    "verify:indexer": "node scripts/verify-indexer.mjs",
    "verify:keystore": "node scripts/verify-keystore.mjs",
    "e2e": "node scripts/e2e.mjs",
    "demo": "node scripts/demo.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@agentx/agent-core": "workspace:*",
    "@agentx/config": "workspace:*",
    "@agentx/db": "workspace:*",
    "@agentx/sdk": "workspace:*",
    "@agentx/shared": "workspace:*",
    "@eslint/js": "^9",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9",
    "globals": "^15",
    "postgres": "^3.4.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8",
    "viem": "^2.57.2",
    "vitest": "^2.1.9",
    "zod": "^3.23.8"
  }
}
