{
  "name": "agentx-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "config:check": "node packages/config/bin/check.mjs",
    "db:migrate": "pnpm --filter @agentx/db migrate",
    "db:seed": "pnpm --filter @agentx/db seed",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
